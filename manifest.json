{
  "manifest_version": 3,
  "name": "Odesoftami QA Monitor",
  "short_name": "QA Monitor",
  "version": "3.2.0",
  "version_name": "3.2.0",
  "description": "Browser QA & Monitoring Tool",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "notifications",
    "alarms",
    "webRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Odesoftami QA Monitor",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "homepage_url": "https://odesoftami.com/apk/",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "refresh-content.js",
        "panel-content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
